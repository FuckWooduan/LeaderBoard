# 复制为 deploy/.env（不要提交 git；含敏感值）。systemd EnvironmentFile 读取。
# 账号种子（StrikeGod pg_dump 导出，含明文密码/pauth）；首次启动且 game_account 为空时导入
RANKHARVESTER_ACCOUNTS_SEEDSQL=/www/wwwroot/rank-harvester/deploy/game_account.sql

# 关闭模拟、连真实游戏服（A–E 真实抓取/登录/在线查询需要）
RANKHARVESTER_GAME_DRYRUN=false

# Redis（本机）。口令由部署机 .env 注入（SPRING_DATA_REDIS_PASSWORD，需与 Redis --requirepass 一致），勿入库 git。db=2
SPRING_DATA_REDIS_HOST=127.0.0.1
SPRING_DATA_REDIS_PORT=6379

# 机器人 AI 网关（OpenAI 兼容；改 Gemini 只需改这三行后重启容器）
# 内网 New API 网关：http://127.0.0.1:4832/v1 ；当前测试用 Claude，待站长接入 Gemini 后改 MODEL/KEY
QQBOT_AI_BASEURL=http://127.0.0.1:4832/v1
QQBOT_AI_MODEL=claude-opus-4-7
QQBOT_AI_APIKEY=   # 机密，填到部署机 deploy/.env，勿入库 git

# QQ 推送（NapCat OneBot）
RANKHARVESTER_QQBOT_ENABLED=true
RANKHARVESTER_QQBOT_HTTPBASEURL=http://127.0.0.1:3000
RANKHARVESTER_QQBOT_ACCESSTOKEN=
RANKHARVESTER_QQBOT_GROUPIDS=

# 人机验证（前端默认极验 GeeTest，可切 Cloudflare Turnstile，任一通过即放行）
# Turnstile：site-key 公开、secret-key 机密
RANKHARVESTER_TURNSTILE_SITEKEY=
RANKHARVESTER_TURNSTILE_SECRETKEY=
# 极验 GeeTest v4：captcha-id 公开(application.yml 有内置默认)、captcha-key 机密(必须在此提供，否则极验不启用)
RANKHARVESTER_GEETEST_CAPTCHAID=
RANKHARVESTER_GEETEST_CAPTCHAKEY=   # 机密，填到部署机 deploy/.env，勿入库 git
